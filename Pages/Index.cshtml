@page
@model TrainingMatrixApp.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Page Header -->
<div class="page-header anim">
    <div>
        <h1 class="page-title">Dashboard</h1>
        <p class="page-subtitle">Welcome back &mdash; here's what's happening today.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-page="/Compliance/Index" class="btn btn-primary">
            <i class="bi bi-shield-check"></i> View Compliance
        </a>
    </div>
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3 anim">
        <div class="stat-card sc-indigo shadow">
            <div class="sc-icon"><i class="bi bi-building"></i></div>
            <div class="sc-value">@Model.TotalDepartments</div>
            <div class="sc-label">Active Departments</div>
            <a asp-page="/Departments/Index" class="sc-link">
                Explore <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3 anim">
        <div class="stat-card sc-emerald shadow">
            <div class="sc-icon"><i class="bi bi-people-fill"></i></div>
            <div class="sc-value">@Model.TotalEmployees</div>
            <div class="sc-label">Active Employees</div>
            <a asp-page="/Employees/Index" class="sc-link">
                Explore <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3 anim">
        <div class="stat-card sc-sky shadow">
            <div class="sc-icon"><i class="bi bi-stars"></i></div>
            <div class="sc-value">@Model.TotalSkills</div>
            <div class="sc-label">Total Skills</div>
            <a asp-page="/Skills/Index" class="sc-link">
                Explore <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3 anim">
        <div class="stat-card sc-amber shadow">
            <div class="sc-icon"><i class="bi bi-journal-bookmark-fill"></i></div>
            <div class="sc-value">@Model.TotalCourses</div>
            <div class="sc-label">Training Courses</div>
            <a asp-page="/TrainingCourses/Index" class="sc-link">
                Explore <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
</div>

<!-- Recent Activity -->
<div class="row">
    <div class="col-lg-8 anim">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">
                    <i class="bi bi-activity ct-icon"></i>
                    Recent Activity
                </h5>
                <span class="badge bg-secondary">Last 10 events</span>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentAuditLogs.Any())
                {
                    <div class="activity-feed">
                        @foreach (var log in Model.RecentAuditLogs)
                        {
                            <div class="activity-row">
                                <div class="activity-dot @(log.ActionType == "Add" ? "dot-add" : log.ActionType == "Delete" ? "dot-delete" : "dot-update")"></div>
                                <div class="activity-body">
                                    <div class="activity-desc">
                                        <span class="badge @(log.ActionType == "Add" ? "bg-success" : log.ActionType == "Delete" ? "bg-danger" : "bg-primary") me-1">@log.ActionType</span>
                                        @log.EntityType
                                        @if (!string.IsNullOrEmpty(log.Details))
                                        {
                                            <span class="text-color-muted text-sm"> — @log.Details</span>
                                        }
                                    </div>
                                    <div class="activity-meta">
                                        <i class="bi bi-clock me-1"></i>@log.Timestamp.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                                        @if (!string.IsNullOrEmpty(log.PerformedBy))
                                        {
                                            <span class="ms-2"><i class="bi bi-person me-1"></i>@log.PerformedBy</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <span class="empty-state-icon"><i class="bi bi-inbox"></i></span>
                        <h6>No activity yet</h6>
                        <p>Actions like adding employees or updating skills will appear here.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Quick Links -->
    <div class="col-lg-4 anim">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title"><i class="bi bi-lightning-fill ct-icon"></i> Quick Actions</h5>
            </div>
            <div class="card-body d-flex flex-column gap-2">
                <a asp-page="/Employees/Create" class="btn btn-outline-primary w-100 justify-content-start">
                    <i class="bi bi-person-plus-fill"></i> Add Employee
                </a>
                <a asp-page="/Departments/Create" class="btn btn-outline-primary w-100 justify-content-start">
                    <i class="bi bi-building-add"></i> Add Department
                </a>
                <a asp-page="/Skills/Create" class="btn btn-outline-primary w-100 justify-content-start">
                    <i class="bi bi-patch-plus-fill"></i> Add Skill
                </a>
                <a asp-page="/TrainingCourses/Create" class="btn btn-outline-primary w-100 justify-content-start">
                    <i class="bi bi-plus-circle-fill"></i> Add Training Course
                </a>
                <hr class="my-1" style="border-color: var(--border);">
                <a asp-page="/Compliance/Index" class="btn btn-primary w-100 justify-content-start">
                    <i class="bi bi-shield-check"></i> Compliance Report
                </a>
            </div>
        </div>
    </div>
</div>
