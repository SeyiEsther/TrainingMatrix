@page
@model TrainingMatrixApp.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    @await Html.PartialAsync("_PageHeader", new PageHeaderModel {
        Title = "Dashboard",
        Subtitle = "Overview of training, skills, and compliance across your organisation",
        Icon = "bi-speedometer2"
    })
</div>

<div class="quick-actions">
    <a asp-page="/Employees/Create" class="quick-action"><i class="bi bi-person-plus"></i> Add employee</a>
    <a asp-page="/Departments/Create" class="quick-action"><i class="bi bi-building-add"></i> Add department</a>
    <a asp-page="/Skills/Create" class="quick-action"><i class="bi bi-plus-circle"></i> Add skill</a>
    <a asp-page="/Compliance/Index" class="quick-action"><i class="bi bi-shield-check"></i> View compliance</a>
</div>

<div class="stat-grid">
    <article class="stat-card">
        <div class="stat-card__top">
            <div>
                <div class="stat-card__value">@Model.TotalEmployees</div>
                <div class="stat-card__label">Active employees</div>
            </div>
            <div class="stat-card__icon stat-card__icon--green"><i class="bi bi-people-fill"></i></div>
        </div>
        <a asp-page="/Employees/Index" class="stat-card__link">Manage employees →</a>
    </article>
    <article class="stat-card">
        <div class="stat-card__top">
            <div>
                <div class="stat-card__value">@Model.TotalDepartments</div>
                <div class="stat-card__label">Departments</div>
            </div>
            <div class="stat-card__icon stat-card__icon--blue"><i class="bi bi-building"></i></div>
        </div>
        <a asp-page="/Departments/Index" class="stat-card__link">View structure →</a>
    </article>
    <article class="stat-card">
        <div class="stat-card__top">
            <div>
                <div class="stat-card__value">@Model.ComplianceNotMet</div>
                <div class="stat-card__label">Compliance gaps</div>
            </div>
            <div class="stat-card__icon stat-card__icon--red"><i class="bi bi-shield-exclamation"></i></div>
        </div>
        <a asp-page="/Compliance/Index" class="stat-card__link">Review gaps →</a>
    </article>
    <article class="stat-card">
        <div class="stat-card__top">
            <div>
                <div class="stat-card__value">@Model.TotalSkills</div>
                <div class="stat-card__label">Skills tracked</div>
            </div>
            <div class="stat-card__icon stat-card__icon--violet"><i class="bi bi-tools"></i></div>
        </div>
        <a asp-page="/Skills/Index" class="stat-card__link">Browse skills →</a>
    </article>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="tm-panel h-100">
            <div class="tm-panel__header">
                <h2 class="tm-panel__title"><i class="bi bi-shield-check me-1"></i> Compliance snapshot</h2>
                <a asp-page="/Compliance/Index" class="btn btn-sm btn-outline-primary">Full report</a>
            </div>
            <div class="tm-panel__body">
                @if (Model.ComplianceMet + Model.ComplianceNearlyMet + Model.ComplianceNotMet > 0)
                {
                    <div class="stat-grid mb-0 p-3 pt-2" style="grid-template-columns: repeat(3, 1fr);">
                        <div class="text-center">
                            <div class="stat-card__value text-success">@Model.ComplianceMet</div>
                            <div class="stat-card__label">Met</div>
                        </div>
                        <div class="text-center">
                            <div class="stat-card__value" style="color: var(--tm-warning);">@Model.ComplianceNearlyMet</div>
                            <div class="stat-card__label">Nearly met</div>
                        </div>
                        <div class="text-center">
                            <div class="stat-card__value text-danger">@Model.ComplianceNotMet</div>
                            <div class="stat-card__label">Not met</div>
                        </div>
                    </div>
                    @if (Model.AtRiskCompliance.Any())
                    {
                        <div class="table-responsive">
                            <table class="table tm-table mb-0">
                                <thead>
                                    <tr>
                                        <th>Department</th>
                                        <th>Skill</th>
                                        <th>Gap</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in Model.AtRiskCompliance)
                                    {
                                        <tr class="@(row.ComplianceStatus == "Not Met" ? "compliance-row--not-met" : "compliance-row--nearly")">
                                            <td>@row.DepartmentName</td>
                                            <td>@row.SkillName</td>
                                            <td><strong>@row.ShortfallCount</strong> short</td>
                                            <td><span class="badge @row.GetStatusBadgeClass() status-badge--@(row.ComplianceStatus == "Not Met" ? "not-met" : "nearly")">@row.ComplianceStatus</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
                else
                {
                    @await Html.PartialAsync("_EmptyState", new EmptyStateModel { Icon = "bi-shield", Message = "No compliance requirements configured yet.", ActionText = "Configure departments", ActionUrl = Url.Page("/Departments/Index") })
                }
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="tm-panel h-100">
            <div class="tm-panel__header">
                <h2 class="tm-panel__title"><i class="bi bi-clock-history me-1"></i> Recent activity</h2>
            </div>
            <div class="tm-panel__body">
                @if (Model.RecentAuditLogs.Any())
                {
                    @foreach (var log in Model.RecentAuditLogs)
                    {
                        <div class="activity-item">
                            <span class="badge @(log.ActionType == "Add" ? "bg-success" : log.ActionType == "Delete" ? "bg-danger" : "bg-primary")">@log.ActionType</span>
                            <div>
                                <div class="activity-item__detail">@log.Details</div>
                                <small class="text-muted">@log.EntityType · @log.PerformedBy</small>
                            </div>
                            <span class="activity-item__time">@log.Timestamp.ToLocalTime().ToString("dd MMM HH:mm")</span>
                        </div>
                    }
                }
                else
                {
                    @await Html.PartialAsync("_EmptyState", new EmptyStateModel { Icon = "bi-inbox", Message = "No activity recorded yet." })
                }
            </div>
        </div>
    </div>
</div>
