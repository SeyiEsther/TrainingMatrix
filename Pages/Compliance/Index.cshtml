@page
@model TrainingMatrixApp.Pages.Compliance.IndexModel
@{
    ViewData["Title"] = "Compliance Dashboard";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-4"><i class="bi bi-shield-check"></i> Compliance Dashboard</h1>
            <p class="text-muted">Skill compliance status by department</p>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-5">
            <form method="get">
                <div class="row g-2">
                    <div class="col-md-8">
                        <select name="departmentFilter" class="form-select">
                            <option value="">-- All Departments --</option>
                            @foreach (var dept in Model.DepartmentList)
                            {
                                <option value="@dept.Value" selected="@(dept.Value == Model.DepartmentFilter?.ToString())">@dept.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-outline-primary" type="submit">
                            <i class="bi bi-filter"></i> Filter
                        </button>
                        <a asp-page="Index" class="btn btn-outline-secondary ms-1">
                            <i class="bi bi-x-circle"></i> Clear
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (Model.ComplianceData.Any())
    {
        var metCount = Model.ComplianceData.Count(c => c.ComplianceStatus == "Met");
        var nearlyMetCount = Model.ComplianceData.Count(c => c.ComplianceStatus == "Nearly Met");
        var notMetCount = Model.ComplianceData.Count(c => c.ComplianceStatus == "Not Met");

        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card text-white bg-success shadow text-center">
                    <div class="card-body">
                        <div class="fs-2 fw-bold">@metCount</div>
                        <div>Requirements Met</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-white bg-warning shadow text-center">
                    <div class="card-body">
                        <div class="fs-2 fw-bold">@nearlyMetCount</div>
                        <div>Nearly Met</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-white bg-danger shadow text-center">
                    <div class="card-body">
                        <div class="fs-2 fw-bold">@notMetCount</div>
                        <div>Not Met</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Department</th>
                                <th>Skill</th>
                                <th>Priority</th>
                                <th>Required</th>
                                <th>Qualified</th>
                                <th>Shortfall</th>
                                <th>Min. Proficiency</th>
                                <th>Compliance %</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.ComplianceData)
                            {
                                <tr>
                                    <td><strong>@item.DepartmentName</strong></td>
                                    <td>@item.SkillName</td>
                                    <td><span class="badge @item.GetPriorityBadgeClass()">@item.Priority</span></td>
                                    <td class="text-center">@item.RequiredCount</td>
                                    <td class="text-center">@item.CurrentQualifiedCount</td>
                                    <td class="text-center">
                                        @if (item.ShortfallCount > 0)
                                        {
                                            <span class="text-danger fw-bold">@item.ShortfallCount</span>
                                        }
                                        else
                                        {
                                            <span class="text-success">0</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <i class="bi @(i <= item.MinimumProficiencyLevel ? "bi-star-fill text-warning" : "bi-star text-muted")"></i>
                                        }
                                    </td>
                                    <td>
                                        <div class="progress" style="height: 20px;">
                                            <div class="progress-bar @(item.CompliancePercentage >= 100 ? "bg-success" : item.CompliancePercentage >= 75 ? "bg-warning" : "bg-danger")"
                                                 role="progressbar"
                                                 style="width: @item.CompliancePercentage%"
                                                 aria-valuenow="@item.CompliancePercentage" aria-valuemin="0" aria-valuemax="100">
                                                @item.CompliancePercentage%
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge @item.GetStatusBadgeClass()">@item.ComplianceStatus</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No compliance requirements found. 
            Configure department skill requirements to see compliance data.
        </div>
    }
</div>
