@page
@model TrainingMatrixApp.Pages.Compliance.IndexModel
@{
    ViewData["Title"] = "Compliance";
}

<div class="page-header">
    @await Html.PartialAsync("_PageHeader", new PageHeaderModel {
        Title = "Compliance",
        Subtitle = "Track whether departments meet their skill requirements",
        Icon = "bi-shield-check"
    })
</div>

<div class="filter-bar">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-6">
            <label class="form-label">Department</label>
            <select name="departmentId" class="form-select">
                <option value="">All departments</option>
                @foreach (var dept in Model.DepartmentList)
                {
                    <option value="@dept.Value" selected="@(dept.Value == Model.SelectedDepartmentId?.ToString())">@dept.Text</option>
                }
            </select>
        </div>
        <div class="col-md-6 d-flex gap-2 align-items-end">
            <button class="btn btn-primary" type="submit"><i class="bi bi-funnel"></i> Apply filter</button>
            <a asp-page="Index" class="btn btn-outline-secondary">Clear</a>
            <div class="ms-auto d-none d-md-flex gap-2 align-items-center">
                <span class="badge status-badge--met">Met</span>
                <span class="badge status-badge--nearly">Nearly met</span>
                <span class="badge status-badge--not-met">Not met</span>
            </div>
        </div>
    </form>
</div>

@if (Model.ComplianceData.Any())
{
    <div class="stat-grid" style="grid-template-columns: repeat(3, 1fr);">
        <article class="stat-card">
            <div class="stat-card__value text-success">@Model.ComplianceData.Count(r => r.ComplianceStatus == "Met")</div>
            <div class="stat-card__label">Requirements met</div>
        </article>
        <article class="stat-card">
            <div class="stat-card__value" style="color: var(--tm-warning);">@Model.ComplianceData.Count(r => r.ComplianceStatus == "Nearly Met")</div>
            <div class="stat-card__label">Nearly met</div>
        </article>
        <article class="stat-card">
            <div class="stat-card__value text-danger">@Model.ComplianceData.Count(r => r.ComplianceStatus == "Not Met")</div>
            <div class="stat-card__label">Not met</div>
        </article>
    </div>

    <div class="tm-panel">
        <div class="tm-panel__body">
            <div class="table-responsive">
                <table class="table tm-table mb-0">
                    <thead>
                        <tr>
                            <th>Department</th>
                            <th>Skill</th>
                            <th>Priority</th>
                            <th>Required</th>
                            <th>Qualified</th>
                            <th>Shortfall</th>
                            <th>Progress</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.ComplianceData)
                        {
                            <tr class="@(row.ComplianceStatus == "Not Met" ? "compliance-row--not-met" : row.ComplianceStatus == "Nearly Met" ? "compliance-row--nearly" : "")">
                                <td>@row.DepartmentName</td>
                                <td class="fw-semibold">@row.SkillName</td>
                                <td><span class="badge @row.GetPriorityBadgeClass()">@row.Priority</span></td>
                                <td>@row.RequiredCount at L@row.MinimumProficiencyLevel+</td>
                                <td><strong>@row.CurrentQualifiedCount</strong></td>
                                <td>
                                    @if (row.ShortfallCount > 0)
                                    {
                                        <span class="text-danger fw-bold">@row.ShortfallCount</span>
                                    }
                                    else
                                    {
                                        <span class="text-success">0</span>
                                    }
                                </td>
                                <td style="min-width: 120px;">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 6px;">
                                            <div class="progress-bar @(row.ComplianceStatus == "Met" ? "bg-success" : row.ComplianceStatus == "Nearly Met" ? "bg-warning" : "bg-danger")"
                                                 style="width: @row.CompliancePercentage%"></div>
                                        </div>
                                        <small class="text-muted">@row.CompliancePercentage%</small>
                                    </div>
                                </td>
                                <td><span class="badge @row.GetStatusBadgeClass()">@row.ComplianceStatus</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="tm-panel">
        <div class="tm-panel__body tm-panel__body--padded">
            @await Html.PartialAsync("_EmptyState", new EmptyStateModel { Icon = "bi-shield", Message = "No compliance requirements found. Configure skill requirements on department details pages.", ActionText = "View departments", ActionUrl = Url.Page("/Departments/Index") })
        </div>
    </div>
}
