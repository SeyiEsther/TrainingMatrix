@page
@model TrainingMatrixApp.Pages.Compliance.IndexModel
@{
    ViewData["Title"] = "Compliance Dashboard";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-4"><i class="bi bi-shield-check"></i> Compliance Dashboard</h1>
            <p class="text-muted">Department skill compliance status</p>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <form method="get">
                <div class="row g-2">
                    <div class="col-md-7">
                        <select name="departmentId" class="form-select">
                            <option value="">-- All Departments --</option>
                            @foreach (var dept in Model.DepartmentList)
                            {
                                <option value="@dept.Value" selected="@(dept.Value == Model.SelectedDepartmentId?.ToString())">@dept.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-outline-primary" type="submit">
                            <i class="bi bi-filter"></i> Filter
                        </button>
                        <a asp-page="Index" class="btn btn-outline-secondary ms-1">
                            <i class="bi bi-x-circle"></i> Clear
                        </a>
                    </div>
                </div>
            </form>
        </div>
        <div class="col-md-6 text-end">
            <span class="badge bg-success me-1">Met</span>
            <span class="badge bg-warning me-1">Nearly Met</span>
            <span class="badge bg-danger">Not Met</span>
        </div>
    </div>

    @if (Model.ComplianceData.Any())
    {
        <!-- Summary Cards -->
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card text-white bg-success shadow">
                    <div class="card-body text-center">
                        <div class="fs-3 fw-bold">@Model.ComplianceData.Count(r => r.ComplianceStatus == "Met")</div>
                        <div>Requirements Met</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-white bg-warning shadow">
                    <div class="card-body text-center">
                        <div class="fs-3 fw-bold">@Model.ComplianceData.Count(r => r.ComplianceStatus == "Nearly Met")</div>
                        <div>Nearly Met</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-white bg-danger shadow">
                    <div class="card-body text-center">
                        <div class="fs-3 fw-bold">@Model.ComplianceData.Count(r => r.ComplianceStatus == "Not Met")</div>
                        <div>Not Met</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Department</th>
                                <th>Skill</th>
                                <th>Priority</th>
                                <th>Required (Count / Level)</th>
                                <th>Qualified</th>
                                <th>Shortfall</th>
                                <th>Compliance %</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.ComplianceData)
                            {
                                <tr class="@(row.ComplianceStatus == "Not Met" ? "table-danger" : row.ComplianceStatus == "Nearly Met" ? "table-warning" : "")">
                                    <td>@row.DepartmentName</td>
                                    <td>@row.SkillName</td>
                                    <td>
                                        <span class="badge @row.GetPriorityBadgeClass()">@row.Priority</span>
                                    </td>
                                    <td>@row.RequiredCount employees at level @row.MinimumProficiencyLevel+</td>
                                    <td>
                                        <span class="fw-bold">@row.CurrentQualifiedCount</span>
                                    </td>
                                    <td>
                                        @if (row.ShortfallCount > 0)
                                        {
                                            <span class="text-danger fw-bold">@row.ShortfallCount</span>
                                        }
                                        else
                                        {
                                            <span class="text-success">0</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" style="height: 8px;">
                                                <div class="progress-bar @(row.ComplianceStatus == "Met" ? "bg-success" : row.ComplianceStatus == "Nearly Met" ? "bg-warning" : "bg-danger")"
                                                     style="width: @row.CompliancePercentage%"></div>
                                            </div>
                                            <small>@row.CompliancePercentage%</small>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge @row.GetStatusBadgeClass()">@row.ComplianceStatus</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i>
            No compliance requirements found.
            @if (Model.SelectedDepartmentId.HasValue)
            {
                <span> Try clearing the department filter.</span>
            }
            else
            {
                <span> Configure skill requirements on departments to see compliance data.</span>
            }
        </div>
    }
</div>
