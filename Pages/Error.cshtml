@page
@model TrainingMatrixApp.Pages.ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-8">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0"><i class="bi bi-exclamation-triangle-fill"></i> An Error Occurred</h4>
                </div>
                <div class="card-body">
                    <h5 class="card-title">Sorry, something went wrong.</h5>
                    @if (Model.ShowRequestId)
                    {
                        <p>
                            <strong>Request ID:</strong> <code>@Model.RequestId</code>
                        </p>
                    }
                    <p class="text-muted">
                        Please try again. If the problem persists, contact your system administrator.
                    </p>
                    <a asp-page="/Index" class="btn btn-primary">
                        <i class="bi bi-house"></i> Return to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
