<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Training Matrix</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="app-shell">

    <!-- ══ Sidebar ══ -->
    <aside class="sidebar" id="sidebar">
        <a class="sidebar-brand" asp-page="/Index">
            <div class="brand-icon"><i class="bi bi-mortarboard-fill"></i></div>
            <div class="brand-text">
                <span class="brand-name">Training Matrix</span>
                <span class="brand-sub">Skills &amp; Compliance</span>
            </div>
        </a>

        <nav class="sidebar-nav">
            <div class="nav-section-label">Navigation</div>

            <a class="nav-link-item @(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")"
               asp-page="/Index">
                <i class="bi bi-speedometer2 ni"></i>
                Dashboard
            </a>

            <div class="nav-section-label mt-2">Organisation</div>

            <a class="nav-link-item @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Departments") == true ? "active" : "")"
               asp-page="/Departments/Index">
                <i class="bi bi-building ni"></i>
                Departments
            </a>

            <a class="nav-link-item @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Employees") == true ? "active" : "")"
               asp-page="/Employees/Index">
                <i class="bi bi-people-fill ni"></i>
                Employees
            </a>

            <div class="nav-section-label mt-2">Learning</div>

            <a class="nav-link-item @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Skills") == true ? "active" : "")"
               asp-page="/Skills/Index">
                <i class="bi bi-stars ni"></i>
                Skills
            </a>

            <a class="nav-link-item @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/TrainingCourses") == true ? "active" : "")"
               asp-page="/TrainingCourses/Index">
                <i class="bi bi-journal-bookmark-fill ni"></i>
                Training Courses
            </a>

            <a class="nav-link-item @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/TrainingTasks") == true ? "active" : "")"
               asp-page="/TrainingTasks/Index">
                <i class="bi bi-list-check ni"></i>
                Training Tasks
            </a>

            <div class="nav-section-label mt-2">Reports</div>

            <a class="nav-link-item @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Compliance") == true ? "active" : "")"
               asp-page="/Compliance/Index">
                <i class="bi bi-shield-check ni"></i>
                Compliance
            </a>
        </nav>

        <div class="sidebar-footer">
            <div class="sidebar-user">
                <div class="user-avatar"><i class="bi bi-person-fill" style="font-size:0.85rem;"></i></div>
                <div class="user-info">
                    <div class="user-name">@(User?.Identity?.Name ?? "User")</div>
                    <div class="user-role">Authenticated</div>
                </div>
            </div>
        </div>
    </aside>

    <!-- ══ Sidebar overlay (mobile) ══ -->
    <div class="sidebar-mask" id="sidebarMask" onclick="closeSidebar()"></div>

    <!-- ══ Content ══ -->
    <div class="content-shell">

        <!-- Top bar -->
        <header class="topbar">
            <div class="d-flex align-items-center gap-2">
                <button class="topbar-toggle" onclick="toggleSidebar()" aria-label="Toggle navigation">
                    <i class="bi bi-list" style="font-size:1.1rem;"></i>
                </button>
                <div class="topbar-breadcrumb">
                    <span>Training Matrix</span>
                    <span class="bc-sep"><i class="bi bi-chevron-right" style="font-size:0.6rem;"></i></span>
                    <span class="bc-current">@ViewData["Title"]</span>
                </div>
            </div>
            <div class="topbar-right">
                <span class="topbar-badge">
                    <i class="bi bi-circle-fill" style="font-size:0.5rem; color:#6ee7b7;"></i>
                    Live
                </span>
            </div>
        </header>

        <!-- Page content -->
        <main class="main">
            @RenderBody()
        </main>

        <footer class="app-footer">
            &copy; @DateTime.Now.Year Training Matrix &mdash; Employee Skills &amp; Compliance Management
        </footer>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script>
    function toggleSidebar() {
        const s = document.getElementById('sidebar');
        const m = document.getElementById('sidebarMask');
        s.classList.toggle('open');
        m.classList.toggle('show');
    }
    function closeSidebar() {
        document.getElementById('sidebar').classList.remove('open');
        document.getElementById('sidebarMask').classList.remove('show');
    }
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
