@page
@model TrainingMatrixApp.Pages.Departments.DeleteModel
@{
    ViewData["Title"] = "Delete Department";
}

<div class="container">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-4 text-danger">Delete Department</h1>
        </div>
    </div>

    <div class="alert alert-warning" role="alert">
        <h4 class="alert-heading">Warning!</h4>
        <p>Are you sure you want to delete this department? This will deactivate the department record.</p>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">Department Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Department Name:</dt>
                        <dd class="col-sm-8">@Model.Department.Name</dd>

                        <dt class="col-sm-4">Type:</dt>
                        <dd class="col-sm-8">
                            <span class="badge @(Model.Department.ParentDepartmentId == null ? "bg-primary" : "bg-info")">
                                @(Model.Department.DepartmentType ?? "N/A")
                            </span>
                        </dd>

                        @if (Model.Department.ParentDepartment != null)
                        {
                            <dt class="col-sm-4">Parent Department:</dt>
                            <dd class="col-sm-8">@Model.Department.ParentDepartment.Name</dd>
                        }

                        <dt class="col-sm-4">Description:</dt>
                        <dd class="col-sm-8">@(Model.Department.Description ?? "No description")</dd>

                        @if (Model.Department.HeadOfDepartment != null)
                        {
                            <dt class="col-sm-4">Head of Department:</dt>
                            <dd class="col-sm-8">@Model.Department.HeadOfDepartment.FullName</dd>
                        }
                    </dl>

                    <div class="alert alert-info">
                        <strong>Associated Records:</strong>
                        <ul class="mb-0">
                            <li>Active Employees: @Model.EmployeeCount</li>
                            <li>Sub-Departments: @Model.SubDepartmentCount</li>
                        </ul>
                    </div>

                    @if (!Model.CanDelete)
                    {
                        <div class="alert alert-danger">
                            <strong>Cannot Delete Department:</strong>
                            <ul class="mb-0">
                                @foreach (var blocker in Model.DeletionBlockers)
                                {
                                    <li>@blocker</li>
                                }
                            </ul>
                            <hr>
                            <p class="mb-0">
                                <strong>Required Actions:</strong>
                            </p>
                            <ul class="mb-0">
                                @if (Model.EmployeeCount > 0)
                                {
                                    <li>Transfer or deactivate all employees in this department</li>
                                }
                                @if (Model.SubDepartmentCount > 0)
                                {
                                    <li>Delete or reassign all sub-departments</li>
                                }
                            </ul>
                        </div>
                    }

                    <form method="post">
                        <input type="hidden" asp-for="Department.Id" />
                        <div class="mt-3">
                            @if (Model.CanDelete)
                            {
                                <button type="submit" class="btn btn-danger">
                                    <i class="bi bi-trash"></i> Confirm Delete
                                </button>
                            }
                            <a asp-page="Index" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                            <a asp-page="Details" asp-route-id="@Model.Department.Id" class="btn btn-info">
                                <i class="bi bi-info-circle"></i> View Details
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>