@page
@model TrainingMatrixApp.Pages.Departments.DetailsModel
@{
    ViewData["Title"] = "Department Details";

    // Helper for toggling sort direction
    string NextSort(string column)
    {
        var current = (string)HttpContext.Request.Query["SortColumn"];
        var dir = (string)HttpContext.Request.Query["SortDirection"];
        if (current == column)
            return dir == "asc" ? "desc" : "asc";
        return "asc";
    }
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-4">Department Details</h1>
        </div>
        <div class="col-auto">
            <a asp-page="Edit" asp-route-id="@Model.Department.Id" class="btn btn-warning">
                <i class="bi bi-pencil"></i> Edit
            </a>
            <a asp-page="Delete" asp-route-id="@Model.Department.Id" class="btn btn-danger">
                <i class="bi bi-trash"></i> Delete
            </a>
            <a asp-page="Index" class="btn btn-outline-primary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Department Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Name:</dt>
                        <dd class="col-sm-7">@Model.Department.Name</dd>

                        <dt class="col-sm-5">Type:</dt>
                        <dd class="col-sm-7">
                            <span class="badge @(Model.Department.ParentDepartmentId == null ? "bg-primary" : "bg-info")">
                                @Model.Department.DepartmentType
                            </span>
                        </dd>

                        @if (Model.Department.ParentDepartment != null)
                        {
                            <dt class="col-sm-5">Parent:</dt>
                            <dd class="col-sm-7">
                                <a asp-page="Details" asp-route-id="@Model.Department.ParentDepartment.Id">
                                    @Model.Department.ParentDepartment.Name
                                </a>
                            </dd>
                        }

                        <dt class="col-sm-5">Description:</dt>
                        <dd class="col-sm-7">@(Model.Department.Description ?? "No description")</dd>

                        <dt class="col-sm-5">Status:</dt>
                        <dd class="col-sm-7">
                            <span class="badge @(Model.Department.IsActive ? "bg-success" : "bg-danger")">
                                @(Model.Department.IsActive ? "Active" : "Inactive")
                            </span>
                        </dd>

                        <dt class="col-sm-5">Created:</dt>
                        <dd class="col-sm-7">@Model.Department.CreatedDate.ToShortDateString()</dd>
                    </dl>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Head of Department</h5>
                </div>
                <div class="card-body">
                    @if (Model.Department.HeadOfDepartment != null)
                    {
                        <p class="mb-1">
                            <strong>Name:</strong>
                            <a asp-page="/Employees/Details" asp-route-id="@Model.Department.HeadOfDepartment.Id">
                                @Model.Department.HeadOfDepartment.FullName
                            </a>
                        </p>
                        <p class="mb-1">
                            <strong>Employee #:</strong> @Model.Department.HeadOfDepartment.EmployeeNumber
                        </p>
                        <p class="mb-0">
                            <strong>Email:</strong> 
                            <a href="mailto:@Model.Department.HeadOfDepartment.Email">
                                @Model.Department.HeadOfDepartment.Email
                            </a>
                        </p>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No head of department assigned</p>
                        <a asp-page="Edit" asp-route-id="@Model.Department.Id" class="btn btn-sm btn-primary mt-2">
                            Assign Head
                        </a>
                    }
                </div>
            </div>

            @if (Model.Department.ParentDepartmentId == null)
            {
                <div class="card mb-4">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">Statistics</h5>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-7">Sub-Departments:</dt>
                            <dd class="col-sm-5 text-end">
                                <span class="badge bg-secondary">@Model.SubDepartments.Count</span>
                            </dd>

                            <dt class="col-sm-7">Total Employees:</dt>
                            <dd class="col-sm-5 text-end">
                                <span class="badge bg-primary">@Model.TotalEmployees</span>
                            </dd>
                        </dl>
                    </div>
                </div>
            }

            <!-- Skill Requirements -->
            <div class="card mb-4">
                <div class="card-header bg-warning">
                    <h5 class="mb-0"><i class="bi bi-shield-check"></i> Skill Requirements</h5>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (Model.SkillRequirements.Any())
                    {
                        <div class="table-responsive mb-3">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Skill</th>
                                        <th>Required</th>
                                        <th>Min Level</th>
                                        <th>Priority</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var req in Model.SkillRequirements)
                                    {
                                        <tr>
                                            <td>@req.Skill.Name</td>
                                            <td>@req.RequiredCount employees</td>
                                            <td>Level @req.MinimumProficiencyLevel+</td>
                                            <td><span class="badge bg-secondary">@req.Priority</span></td>
                                            <td class="text-end">
                                                <form method="post" asp-page-handler="RemoveSkillRequirement" asp-route-id="@Model.Department.Id" class="d-inline">
                                                    <input type="hidden" name="requirementId" value="@req.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" data-confirm-delete="Remove this skill requirement?">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No skill requirements configured. Add requirements to enable compliance tracking.</p>
                    }

                    @if (Model.SkillList.Any())
                    {
                        <form method="post" asp-page-handler="AddSkillRequirement" asp-route-id="@Model.Department.Id" class="row g-2 align-items-end">
                            <div class="col-md-4">
                                <label class="form-label small">Skill</label>
                                <select asp-for="NewSkillId" asp-items="Model.SkillList" class="form-select form-select-sm" required></select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small">Required Count</label>
                                <input asp-for="NewRequiredCount" type="number" min="1" max="100" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small">Min Level</label>
                                <input asp-for="NewMinimumProficiencyLevel" type="number" min="1" max="5" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small">Priority</label>
                                <select asp-for="NewPriority" class="form-select form-select-sm">
                                    <option value="Low">Low</option>
                                    <option value="Medium">Medium</option>
                                    <option value="High">High</option>
                                    <option value="Critical">Critical</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-sm btn-primary w-100">
                                    <i class="bi bi-plus"></i> Add
                                </button>
                            </div>
                        </form>
                    }
                    else if (Model.SkillRequirements.Any())
                    {
                        <p class="text-muted small mb-0">All active skills have been assigned to this department.</p>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">
                            <a asp-page="/Skills/Create">Create skills</a> before adding requirements.
                        </p>
                    }

                    @if (Model.SkillRequirements.Any())
                    {
                        <div class="mt-2">
                            <a asp-page="/Compliance/Index" asp-route-departmentId="@Model.Department.Id" class="btn btn-sm btn-outline-success">
                                <i class="bi bi-shield-check"></i> View Compliance
                            </a>
                        </div>
                    }
                </div>
            </div>

            <!-- Audit Log Section -->
            <div class="card mb-4">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Audit Log</h5>
                </div>
                <div class="card-body">
                    @if (Model.AuditLogs != null && Model.AuditLogs.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-striped">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>User</th>
                                        <th>Action</th>
                                        <th>Details</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in Model.AuditLogs)
                                    {
                                        <tr>
                                            <td>@log.Timestamp.ToString("g")</td>
                                            <td>@log.PerformedBy</td>
                                            <td>@log.ActionType</td>
                                            <td>@log.Details</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No audit log entries for this department.</p>
                    }
                </div>
            </div>
            <!-- End Audit Log Section -->
        </div>

        <div class="col-lg-8">
            @if (Model.Department.ParentDepartmentId == null && Model.SubDepartments.Any())
            {
                <div class="card mb-4">
                    <div class="card-header bg-warning">
                        <h5 class="mb-0">Sub-Departments</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Head of Department</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var subDept in Model.SubDepartments)
                                    {
                                        <tr>
                                            <td>
                                                <i class="bi bi-diagram-3"></i>
                                                <a asp-page="Details" asp-route-id="@subDept.Id">
                                                    @subDept.Name
                                                </a>
                                            </td>
                                            <td>
                                                @if (subDept.HeadOfDepartment != null)
                                                {
                                                    <a asp-page="/Employees/Details" asp-route-id="@subDept.HeadOfDepartment.Id">
                                                        @subDept.HeadOfDepartment.FullName
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not assigned</span>
                                                }
                                            </td>
                                            <td>
                                                <a asp-page="Edit" asp-route-id="@subDept.Id" class="btn btn-sm btn-warning">
                                                    <i class="bi bi-pencil"></i> Edit
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            <div class="card">
                <div class="card-header bg-secondary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Employees (@Model.PagedEmployees.TotalCount)</h5>
                        <a asp-page="/Employees/Create" class="btn btn-sm btn-light">
                            <i class="bi bi-plus"></i> Add Employee
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.PagedEmployees.Items.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover">
                                <thead>
                                    <tr>
                                        <th>
                                            <a asp-route-id="@Model.Department.Id"
                                               asp-route-pageIndex="1"
                                               asp-route-SortColumn="EmployeeNumber"
                                               asp-route-SortDirection="@NextSort("EmployeeNumber")">
                                                Employee #
                                                @if ((string)HttpContext.Request.Query["SortColumn"] == "EmployeeNumber")
                                                {
                                                    <span>
                                                        @(HttpContext.Request.Query["SortDirection"] == "desc" ? "▼" : "▲")
                                                    </span>
                                                }
                                            </a>
                                        </th>
                                        <th>
                                            <a asp-route-id="@Model.Department.Id"
                                               asp-route-pageIndex="1"
                                               asp-route-SortColumn="FullName"
                                               asp-route-SortDirection="@NextSort("FullName")">
                                                Name
                                                @if ((string)HttpContext.Request.Query["SortColumn"] == "FullName")
                                                {
                                                    <span>
                                                        @(HttpContext.Request.Query["SortDirection"] == "desc" ? "▼" : "▲")
                                                    </span>
                                                }
                                            </a>
                                        </th>
                                        <th>
                                            <a asp-route-id="@Model.Department.Id"
                                               asp-route-pageIndex="1"
                                               asp-route-SortColumn="Email"
                                               asp-route-SortDirection="@NextSort("Email")">
                                                Email
                                                @if ((string)HttpContext.Request.Query["SortColumn"] == "Email")
                                                {
                                                    <span>
                                                        @(HttpContext.Request.Query["SortDirection"] == "desc" ? "▼" : "▲")
                                                    </span>
                                                }
                                            </a>
                                        </th>
                                        <th>
                                            <a asp-route-id="@Model.Department.Id"
                                               asp-route-pageIndex="1"
                                               asp-route-SortColumn="HireDate"
                                               asp-route-SortDirection="@NextSort("HireDate")">
                                                Hire Date
                                                @if ((string)HttpContext.Request.Query["SortColumn"] == "HireDate")
                                                {
                                                    <span>
                                                        @(HttpContext.Request.Query["SortDirection"] == "desc" ? "▼" : "▲")
                                                    </span>
                                                }
                                            </a>
                                        </th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var employee in Model.PagedEmployees.Items)
                                    {
                                        <tr>
                                            <td>@employee.EmployeeNumber</td>
                                            <td>
                                                <a asp-page="/Employees/Details" asp-route-id="@employee.Id">
                                                    @employee.FullName
                                                </a>
                                                @if (employee.Id == Model.Department.HeadOfDepartmentId)
                                                {
                                                    <span class="badge bg-info ms-1">Head</span>
                                                }
                                            </td>
                                            <td>@employee.Email</td>
                                            <td>@employee.HireDate.ToShortDateString()</td>
                                            <td>
                                                <a asp-page="/Employees/Details" asp-route-id="@employee.Id" class="btn btn-sm btn-info">
                                                    <i class="bi bi-info-circle"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination Controls -->
                        <nav aria-label="Employee pagination">
                            <ul class="pagination justify-content-center">
                                <li class="page-item @(Model.PagedEmployees.PageIndex == 1 ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-route-id="@Model.Department.Id"
                                       asp-route-pageIndex="@(Model.PagedEmployees.PageIndex - 1)"
                                       asp-route-SortColumn="@(HttpContext.Request.Query["SortColumn"])"
                                       asp-route-SortDirection="@(HttpContext.Request.Query["SortDirection"])">
                                        Previous
                                    </a>
                                </li>
                                @for (var i = 1; i <= Model.PagedEmployees.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.PagedEmployees.PageIndex ? "active" : "")">
                                        <a class="page-link"
                                           asp-route-id="@Model.Department.Id"
                                           asp-route-pageIndex="@i"
                                           asp-route-SortColumn="@(HttpContext.Request.Query["SortColumn"])"
                                           asp-route-SortDirection="@(HttpContext.Request.Query["SortDirection"])">
                                            @i
                                        </a>
                                    </li>
                                }
                                <li class="page-item @(Model.PagedEmployees.PageIndex == Model.PagedEmployees.TotalPages ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-route-id="@Model.Department.Id"
                                       asp-route-pageIndex="@(Model.PagedEmployees.PageIndex + 1)"
                                       asp-route-SortColumn="@(HttpContext.Request.Query["SortColumn"])"
                                       asp-route-SortDirection="@(HttpContext.Request.Query["SortDirection"])">
                                        Next
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No employees in this department.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>