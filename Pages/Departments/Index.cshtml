@page
@model TrainingMatrixApp.Pages.Departments.IndexModel
@{
    ViewData["Title"] = "Departments";
}

<div class="container-fluid">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row mb-4">
        <div class="col">
            <h1 class="display-4">Department Management</h1>
        </div>
        <div class="col-auto">
            <a asp-page="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Add New Department
            </a>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <form method="get">
                <div class="input-group">
                    <input type="text" name="searchString" value="@Model.SearchString" 
                           class="form-control" placeholder="Search departments...">
                    <button class="btn btn-outline-primary" type="submit">
                        <i class="bi bi-search"></i> Search
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="row">
        <div class="col">
            @if (Model.TopLevelDepartments.Any())
            {
                @foreach (var topDept in Model.TopLevelDepartments)
                {
                    <div class="card mb-3 shadow-sm">
                        <div class="card-header bg-primary text-white">
                            <div class="row align-items-center">
                                <div class="col">
                                    <h5 class="mb-0">
                                        <i class="bi bi-building"></i> @topDept.Name
                                    </h5>
                                </div>
                                <div class="col-auto">
                                    <span class="badge bg-light text-dark">
                                        Top Level Department
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="row mb-3">
                                <div class="col-md-8">
                                    <p class="mb-1">
                                        <strong>Description:</strong> @(topDept.Description ?? "No description")
                                    </p>
                                    <p class="mb-1">
                                        <strong>Head of Department:</strong> 
                                        @if (topDept.HeadOfDepartment != null)
                                        {
                                            <a asp-page="/Employees/Details" asp-route-id="@topDept.HeadOfDepartment.Id">
                                                @topDept.HeadOfDepartment.FullName
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not assigned</span>
                                        }
                                    </p>
                                    <p class="mb-0">
                                        <strong>Sub-Departments:</strong> @topDept.SubDepartments.Count
                                    </p>
                                </div>
                                <div class="col-md-4 text-end">
                                    <a asp-page="Details" asp-route-id="@topDept.Id" class="btn btn-sm btn-info">
                                        <i class="bi bi-info-circle"></i> Details
                                    </a>
                                    <a asp-page="Edit" asp-route-id="@topDept.Id" class="btn btn-sm btn-warning">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <a asp-page="Delete" asp-route-id="@topDept.Id" class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                </div>
                            </div>

                            @if (Model.SubDepartmentsByParent.ContainsKey(topDept.Id))
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Sub-Department</th>
                                                <th>Head of Department</th>
                                                <th>Employees</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var subDept in Model.SubDepartmentsByParent[topDept.Id])
                                            {
                                                <tr>
                                                    <td>
                                                        <i class="bi bi-diagram-3"></i> @subDept.Name
                                                    </td>
                                                    <td>
                                                        @if (subDept.HeadOfDepartment != null)
                                                        {
                                                            <a asp-page="/Employees/Details" asp-route-id="@subDept.HeadOfDepartment.Id">
                                                                @subDept.HeadOfDepartment.FullName
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">Not assigned</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-secondary">
                                                            @(Model.EmployeeCountByDepartment.ContainsKey(subDept.Id) ? Model.EmployeeCountByDepartment[subDept.Id] : 0)
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <div class="btn-group btn-group-sm" role="group">
                                                            <a asp-page="Details" asp-route-id="@subDept.Id" 
                                                               class="btn btn-info" title="Details">
                                                                <i class="bi bi-info-circle"></i>
                                                            </a>
                                                            <a asp-page="Edit" asp-route-id="@subDept.Id" 
                                                               class="btn btn-warning" title="Edit">
                                                                <i class="bi bi-pencil"></i>
                                                            </a>
                                                            <a asp-page="Delete" asp-route-id="@subDept.Id" 
                                                               class="btn btn-danger" title="Delete">
                                                                <i class="bi bi-trash"></i>
                                                            </a>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                }
                <!-- Pagination Controls -->
                <nav aria-label="Department pagination" class="mt-4">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="?page=@(Model.CurrentPage - 1)@(!string.IsNullOrEmpty(Model.SearchString) ? "&searchString=" + Uri.EscapeDataString(Model.SearchString) : "")" tabindex="-1">Previous</a>
                        </li>
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" href="?page=@i@(!string.IsNullOrEmpty(Model.SearchString) ? "&searchString=" + Uri.EscapeDataString(Model.SearchString) : "")">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="?page=@(Model.CurrentPage + 1)@(!string.IsNullOrEmpty(Model.SearchString) ? "&searchString=" + Uri.EscapeDataString(Model.SearchString) : "")">Next</a>
                        </li>
                    </ul>
                </nav>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> No departments found. 
                    <a asp-page="Create" class="alert-link">Create your first department</a>.
                </div>
            }
        </div>
    </div>
</div>