@page
@model TrainingMatrixApp.Pages.Departments.IndexModel
@{
    ViewData["Title"] = "Departments";
}

<partial name="_Alerts" />

<div class="page-header">
    @await Html.PartialAsync("_PageHeader", new PageHeaderModel {
        Title = "Departments",
        Subtitle = "Organisational structure, heads of department, and skill requirements",
        Icon = "bi-building"
    })
    <div class="page-header__actions">
        <a asp-page="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add department</a>
    </div>
</div>

<div class="filter-bar">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-8">
            <label class="form-label">Search</label>
            <input type="text" name="searchString" value="@Model.SearchString"
                   class="form-control" placeholder="Search departments..." />
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button class="btn btn-primary flex-grow-1" type="submit"><i class="bi bi-search"></i> Search</button>
            <a asp-page="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i></a>
        </div>
    </form>
</div>

@if (Model.TopLevelDepartments.Any())
{
    @foreach (var topDept in Model.TopLevelDepartments)
    {
        <article class="dept-card">
            <div class="dept-card__header">
                <div>
                    <h2 class="dept-card__title"><i class="bi bi-building me-1 text-primary"></i>@topDept.Name</h2>
                    <small class="text-muted">@(topDept.Description ?? "No description")</small>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="badge bg-light text-dark border">Top level</span>
                    <div class="tm-actions">
                        <a asp-page="Details" asp-route-id="@topDept.Id" class="tm-action-btn" title="Details"><i class="bi bi-eye"></i></a>
                        <a asp-page="Edit" asp-route-id="@topDept.Id" class="tm-action-btn tm-action-btn--warn" title="Edit"><i class="bi bi-pencil"></i></a>
                        <a asp-page="Delete" asp-route-id="@topDept.Id" class="tm-action-btn tm-action-btn--danger" title="Delete"><i class="bi bi-trash"></i></a>
                    </div>
                </div>
            </div>
            <div class="dept-card__body">
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <small class="text-muted d-block">Head of department</small>
                        @if (topDept.HeadOfDepartment != null)
                        {
                            <a asp-page="/Employees/Details" asp-route-id="@topDept.HeadOfDepartment.Id">@topDept.HeadOfDepartment.FullName</a>
                        }
                        else
                        {
                            <span class="text-muted">Not assigned</span>
                        }
                    </div>
                    <div class="col-md-6">
                        <small class="text-muted d-block">Sub-departments</small>
                        <strong>@topDept.SubDepartments.Count</strong>
                    </div>
                </div>

                @if (Model.SubDepartmentsByParent.ContainsKey(topDept.Id))
                {
                    <div class="table-responsive">
                        <table class="table tm-table mb-0">
                            <thead>
                                <tr>
                                    <th>Sub-department</th>
                                    <th>Head</th>
                                    <th>Employees</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var subDept in Model.SubDepartmentsByParent[topDept.Id])
                                {
                                    <tr>
                                        <td class="fw-semibold"><i class="bi bi-diagram-3 me-1 text-muted"></i>@subDept.Name</td>
                                        <td>
                                            @if (subDept.HeadOfDepartment != null)
                                            {
                                                <a asp-page="/Employees/Details" asp-route-id="@subDept.HeadOfDepartment.Id">@subDept.HeadOfDepartment.FullName</a>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border">
                                                @(Model.EmployeeCountByDepartment.GetValueOrDefault(subDept.Id))
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <div class="tm-actions">
                                                <a asp-page="Details" asp-route-id="@subDept.Id" class="tm-action-btn" title="Details"><i class="bi bi-eye"></i></a>
                                                <a asp-page="Edit" asp-route-id="@subDept.Id" class="tm-action-btn tm-action-btn--warn" title="Edit"><i class="bi bi-pencil"></i></a>
                                                <a asp-page="Delete" asp-route-id="@subDept.Id" class="tm-action-btn tm-action-btn--danger" title="Delete"><i class="bi bi-trash"></i></a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </article>
    }

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Department pagination" class="mt-3">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="?page=@(Model.CurrentPage - 1)@(!string.IsNullOrEmpty(Model.SearchString) ? "&searchString=" + Uri.EscapeDataString(Model.SearchString) : "")">Previous</a>
                </li>
                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="?page=@i@(!string.IsNullOrEmpty(Model.SearchString) ? "&searchString=" + Uri.EscapeDataString(Model.SearchString) : "")">@i</a>
                    </li>
                }
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="?page=@(Model.CurrentPage + 1)@(!string.IsNullOrEmpty(Model.SearchString) ? "&searchString=" + Uri.EscapeDataString(Model.SearchString) : "")">Next</a>
                </li>
            </ul>
        </nav>
    }
}
else
{
    <div class="tm-panel">
        <div class="tm-panel__body tm-panel__body--padded">
            @await Html.PartialAsync("_EmptyState", new EmptyStateModel { Icon = "bi-building", Message = "No departments found.", ActionText = "Create department", ActionUrl = Url.Page("Create") })
        </div>
    </div>
}
