@page
@model TrainingMatrixApp.Pages.Departments.IndexModel
@{
    ViewData["Title"] = "Departments";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show anim" role="alert">
        <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show anim" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="page-header anim">
    <div>
        <h1 class="page-title">Departments</h1>
        <p class="page-subtitle">Manage your organisational structure.</p>
    </div>
    <a asp-page="Create" class="btn btn-primary">
        <i class="bi bi-building-add"></i> Add Department
    </a>
</div>

<!-- Search -->
<form method="get">
    <div class="search-bar anim">
        <div class="search-field flex-grow-1" style="max-width:360px;">
            <i class="bi bi-search"></i>
            <input type="text" name="searchString" value="@ViewData["SearchString"]"
                   class="form-control" placeholder="Search departments…">
        </div>
        <button class="btn btn-primary" type="submit"><i class="bi bi-search"></i> Search</button>
        @if (ViewData["SearchString"] != null)
        {
            <a asp-page="Index" class="btn btn-outline-secondary"><i class="bi bi-x"></i> Clear</a>
        }
    </div>
</form>

@if (Model.TopLevelDepartments.Any())
{
    @foreach (var topDept in Model.TopLevelDepartments)
    {
        <div class="card dept-card anim">
            <!-- Header -->
            <div class="dept-card-header">
                <div>
                    <h5 class="dept-card-title">
                        <i class="bi bi-building"></i> @topDept.Name
                    </h5>
                    @if (!string.IsNullOrEmpty(topDept.Description))
                    {
                        <div class="text-xs mt-1" style="color:rgba(255,255,255,0.6);">@topDept.Description</div>
                    }
                </div>
                <div class="dept-card-meta">
                    @if (topDept.HeadOfDepartment != null)
                    {
                        <span style="background:rgba(255,255,255,0.12);color:rgba(255,255,255,0.9);font-size:0.72rem;padding:3px 10px;border-radius:99px;display:flex;align-items:center;gap:4px;">
                            <i class="bi bi-person-fill"></i> @topDept.HeadOfDepartment.FullName
                        </span>
                    }
                    <span style="background:rgba(255,255,255,0.12);color:rgba(255,255,255,0.9);font-size:0.72rem;padding:3px 10px;border-radius:99px;">
                        @topDept.SubDepartments.Count sub-dept@(topDept.SubDepartments.Count == 1 ? "" : "s")
                    </span>
                    <div class="d-flex gap-1">
                        <a asp-page="Details" asp-route-id="@topDept.Id" class="btn btn-sm btn-icon" style="background:rgba(255,255,255,0.15);color:white;" title="Details">
                            <i class="bi bi-info-circle"></i>
                        </a>
                        <a asp-page="Edit" asp-route-id="@topDept.Id" class="btn btn-sm btn-icon" style="background:rgba(255,255,255,0.15);color:white;" title="Edit">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-page="Delete" asp-route-id="@topDept.Id" class="btn btn-sm btn-icon" style="background:rgba(239,68,68,0.3);color:white;" title="Delete">
                            <i class="bi bi-trash"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Sub-departments -->
            <div class="dept-card-body">
                @if (Model.SubDepartmentsByParent.ContainsKey(topDept.Id))
                {
                    <div class="table-responsive">
                        <table class="table" style="margin:0;">
                            <thead>
                                <tr>
                                    <th>Sub-Department</th>
                                    <th>Head of Department</th>
                                    <th>Employees</th>
                                    <th style="width:100px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var subDept in Model.SubDepartmentsByParent[topDept.Id])
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-diagram-3 text-color-muted"></i>
                                                <span class="fw-600">@subDept.Name</span>
                                            </div>
                                        </td>
                                        <td>
                                            @if (subDept.HeadOfDepartment != null)
                                            {
                                                <a asp-page="/Employees/Details" asp-route-id="@subDept.HeadOfDepartment.Id"
                                                   class="text-color-primary text-sm" style="text-decoration:none;">
                                                    <i class="bi bi-person me-1"></i>@subDept.HeadOfDepartment.FullName
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-color-muted text-xs">Not assigned</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary">
                                                @(Model.EmployeeCountByDepartment.ContainsKey(subDept.Id) ? Model.EmployeeCountByDepartment[subDept.Id] : 0)
                                            </span>
                                        </td>
                                        <td>
                                            <div class="d-flex gap-1">
                                                <a asp-page="Details" asp-route-id="@subDept.Id" class="btn btn-sm btn-info btn-icon" title="Details"><i class="bi bi-info-circle"></i></a>
                                                <a asp-page="Edit" asp-route-id="@subDept.Id" class="btn btn-sm btn-warning btn-icon" title="Edit"><i class="bi bi-pencil"></i></a>
                                                <a asp-page="Delete" asp-route-id="@subDept.Id" class="btn btn-sm btn-danger btn-icon" title="Delete"><i class="bi bi-trash"></i></a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="py-3 px-4 text-color-muted text-sm">
                        <i class="bi bi-diagram-3 me-1"></i> No sub-departments.
                        <a asp-page="Create" class="ms-1">Add one</a>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Department pagination" class="mt-3">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="?page=@(Model.CurrentPage - 1)@(ViewData["SearchString"] != null ? "&searchString=" + ViewData["SearchString"] : "")">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="?page=@i@(ViewData["SearchString"] != null ? "&searchString=" + ViewData["SearchString"] : "")">@i</a>
                    </li>
                }
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="?page=@(Model.CurrentPage + 1)@(ViewData["SearchString"] != null ? "&searchString=" + ViewData["SearchString"] : "")">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
}
else
{
    <div class="card anim">
        <div class="card-body">
            <div class="empty-state">
                <span class="empty-state-icon"><i class="bi bi-building"></i></span>
                <h6>No departments found</h6>
                <p><a asp-page="Create">Create your first department</a></p>
            </div>
        </div>
    </div>
}
