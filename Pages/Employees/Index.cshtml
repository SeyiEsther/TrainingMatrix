@page
@model TrainingMatrixApp.Pages.Employees.IndexModel
@{
    ViewData["Title"] = "Employees";
}

<partial name="_Alerts" />

<div class="page-header">
    @await Html.PartialAsync("_PageHeader", new PageHeaderModel {
        Title = "Employees",
        Subtitle = "Search, filter, and manage your workforce",
        Icon = "bi-people-fill"
    })
    <div class="page-header__actions">
        <a asp-page="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Add employee
        </a>
    </div>
</div>

<div class="filter-bar">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label">Search</label>
            <input type="text" name="searchString" value="@Model.SearchString"
                   class="form-control" placeholder="Name or employee number..." />
        </div>
        <div class="col-md-4">
            <label class="form-label">Department</label>
            <select name="departmentFilter" class="form-select">
                <option value="">All departments</option>
                @foreach (var dept in Model.DepartmentList)
                {
                    <option value="@dept.Value" selected="@(dept.Value == Model.DepartmentFilter)">@dept.Text</option>
                }
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button class="btn btn-primary flex-grow-1" type="submit"><i class="bi bi-search"></i> Apply</button>
            <a asp-page="Index" class="btn btn-outline-secondary" title="Clear filters"><i class="bi bi-x-lg"></i></a>
        </div>
    </form>
</div>

<div class="tm-panel">
    <div class="tm-panel__header">
        <h2 class="tm-panel__title">@Model.Employees.Count employee@(Model.Employees.Count == 1 ? "" : "s")</h2>
    </div>
    <div class="tm-panel__body">
        @if (Model.Employees.Any())
        {
            <div class="table-responsive">
                <table class="table tm-table mb-0">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Employee #</th>
                            <th>Department</th>
                            <th>Email</th>
                            <th>Hire date</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var emp in Model.Employees)
                        {
                            <tr>
                                <td>
                                    <a asp-page="Details" asp-route-id="@emp.Id" class="fw-semibold text-decoration-none">@emp.FullName</a>
                                </td>
                                <td><code>@emp.EmployeeNumber</code></td>
                                <td>@emp.Department?.Name</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(emp.Email))
                                    {
                                        <a href="mailto:@emp.Email" class="text-muted">@emp.Email</a>
                                    }
                                </td>
                                <td class="text-muted">@emp.HireDate.ToString("dd MMM yyyy")</td>
                                <td class="text-end">
                                    <div class="tm-actions">
                                        <a asp-page="Details" asp-route-id="@emp.Id" class="tm-action-btn" data-bs-toggle="tooltip" title="View details"><i class="bi bi-eye"></i></a>
                                        <a asp-page="Edit" asp-route-id="@emp.Id" class="tm-action-btn tm-action-btn--warn" data-bs-toggle="tooltip" title="Edit"><i class="bi bi-pencil"></i></a>
                                        <a asp-page="Delete" asp-route-id="@emp.Id" class="tm-action-btn tm-action-btn--danger" data-bs-toggle="tooltip" title="Delete"><i class="bi bi-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            @await Html.PartialAsync("_EmptyState", new EmptyStateModel { Icon = "bi-people", Message = "No employees match your search.", ActionText = "Add employee", ActionUrl = Url.Page("Create") })
        }
    </div>
</div>
