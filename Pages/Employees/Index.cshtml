@page
@model TrainingMatrixApp.Pages.Employees.IndexModel
@{
    ViewData["Title"] = "Employees";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show anim" role="alert">
        <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show anim" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="page-header anim">
    <div>
        <h1 class="page-title">Employees</h1>
        <p class="page-subtitle">Manage your workforce and track assignments.</p>
    </div>
    <a asp-page="Create" class="btn btn-primary">
        <i class="bi bi-person-plus-fill"></i> Add Employee
    </a>
</div>

<!-- Search Bar -->
<form method="get">
    <div class="search-bar anim">
        <div class="search-field flex-grow-1" style="max-width:320px;">
            <i class="bi bi-search"></i>
            <input type="text" name="searchString" value="@Model.SearchString"
                   class="form-control" placeholder="Search by name or employee number…">
        </div>
        <div style="min-width:200px;">
            <select name="departmentFilter" class="form-select">
                <option value="">All Departments</option>
                @foreach (var dept in Model.DepartmentList)
                {
                    <option value="@dept.Value" selected="@(dept.Value == Model.DepartmentFilter)">@dept.Text</option>
                }
            </select>
        </div>
        <button class="btn btn-primary" type="submit">
            <i class="bi bi-search"></i> Search
        </button>
        <a asp-page="Index" class="btn btn-outline-secondary">
            <i class="bi bi-x"></i> Clear
        </a>
    </div>
</form>

<!-- Table Card -->
<div class="card anim">
    <div class="card-body p-0">
        @if (Model.Employees.Any())
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Number</th>
                            <th>Department</th>
                            <th>Email</th>
                            <th>Hire Date</th>
                            <th style="width:110px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var emp in Model.Employees)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#6366f1,#8b5cf6);display:flex;align-items:center;justify-content:center;color:white;font-size:0.72rem;font-weight:700;flex-shrink:0;">
                                            @(string.IsNullOrEmpty(emp.FullName) ? "?" : emp.FullName.Substring(0,1).ToUpper())
                                        </div>
                                        <span class="fw-600">@emp.FullName</span>
                                    </div>
                                </td>
                                <td><code style="background:#f1f5f9;padding:2px 7px;border-radius:5px;font-size:0.78rem;color:var(--primary);">@emp.EmployeeNumber</code></td>
                                <td>
                                    @if (emp.Department != null)
                                    {
                                        <span class="badge bg-secondary">@emp.Department.Name</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(emp.Email))
                                    {
                                        <a href="mailto:@emp.Email" class="text-sm text-color-primary" style="text-decoration:none;">
                                            <i class="bi bi-envelope me-1"></i>@emp.Email
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-color-muted text-xs">—</span>
                                    }
                                </td>
                                <td class="text-sm text-color-muted">@emp.HireDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-page="Details" asp-route-id="@emp.Id" class="btn btn-sm btn-info btn-icon" title="Details">
                                            <i class="bi bi-info-circle"></i>
                                        </a>
                                        <a asp-page="Edit" asp-route-id="@emp.Id" class="btn btn-sm btn-warning btn-icon" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-page="Delete" asp-route-id="@emp.Id" class="btn btn-sm btn-danger btn-icon" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <span class="empty-state-icon"><i class="bi bi-people"></i></span>
                <h6>No employees found</h6>
                <p>
                    @if (!string.IsNullOrEmpty(Model.SearchString) || !string.IsNullOrEmpty(Model.DepartmentFilter))
                    {
                        <span>Try adjusting your search filters.</span>
                    }
                    else
                    {
                        <a asp-page="Create">Add your first employee</a>
                    }
                </p>
            </div>
        }
    </div>
</div>
