@page
@model TrainingMatrixApp.Pages.Employees.IndexModel
@{
    ViewData["Title"] = "Employees";
}

<div class="container-fluid">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row mb-4">
        <div class="col">
            <h1 class="display-4"><i class="bi bi-people-fill"></i> Employee Management</h1>
        </div>
        <div class="col-auto">
            <a asp-page="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Add New Employee
            </a>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-8">
            <form method="get">
                <div class="row g-2">
                    <div class="col-md-5">
                        <input type="text" name="searchString" value="@Model.SearchString"
                               class="form-control" placeholder="Search by name or employee number...">
                    </div>
                    <div class="col-md-4">
                        <select name="departmentFilter" class="form-select">
                            <option value="">-- All Departments --</option>
                            @foreach (var dept in Model.DepartmentList)
                            {
                                <option value="@dept.Value" selected="@(dept.Value == Model.DepartmentFilter)">@dept.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-outline-primary" type="submit">
                            <i class="bi bi-search"></i> Search
                        </button>
                        <a asp-page="Index" class="btn btn-outline-secondary ms-1">
                            <i class="bi bi-x-circle"></i> Clear
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow">
        <div class="card-body p-0">
            @if (Model.Employees.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Name</th>
                                <th>Employee #</th>
                                <th>Department</th>
                                <th>Email</th>
                                <th>Hire Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var emp in Model.Employees)
                            {
                                <tr>
                                    <td>
                                        <i class="bi bi-person-circle text-muted me-1"></i>
                                        @emp.FullName
                                    </td>
                                    <td><code>@emp.EmployeeNumber</code></td>
                                    <td>@emp.Department?.Name</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(emp.Email))
                                        {
                                            <a href="mailto:@emp.Email">@emp.Email</a>
                                        }
                                    </td>
                                    <td>@emp.HireDate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-page="Details" asp-route-id="@emp.Id" class="btn btn-info" title="Details">
                                                <i class="bi bi-info-circle"></i>
                                            </a>
                                            <a asp-page="Edit" asp-route-id="@emp.Id" class="btn btn-warning" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-page="Delete" asp-route-id="@emp.Id" class="btn btn-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-4 text-center text-muted">
                    <i class="bi bi-inbox fs-3"></i>
                    <p class="mt-2">No employees found. <a asp-page="Create" class="alert-link">Add the first employee</a>.</p>
                </div>
            }
        </div>
    </div>
</div>
