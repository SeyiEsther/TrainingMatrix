@page
@model TrainingMatrixApp.Pages.Employees.EditModel
@{
    ViewData["Title"] = "Edit Employee";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-4"><i class="bi bi-pencil-square"></i> Edit Employee</h1>
        </div>
        <div class="col-auto">
            <a asp-page="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-warning">
                    <h5 class="mb-0">Edit: @Model.Employee.FullName</h5>
                </div>
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" asp-for="Employee.Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Employee.FirstName" class="form-label fw-semibold"></label>
                                <input asp-for="Employee.FirstName" class="form-control" />
                                <span asp-validation-for="Employee.FirstName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Employee.LastName" class="form-label fw-semibold"></label>
                                <input asp-for="Employee.LastName" class="form-control" />
                                <span asp-validation-for="Employee.LastName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Employee.EmployeeNumber" class="form-label fw-semibold"></label>
                                <input asp-for="Employee.EmployeeNumber" class="form-control" />
                                <span asp-validation-for="Employee.EmployeeNumber" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Employee.HireDate" class="form-label fw-semibold"></label>
                                <input asp-for="Employee.HireDate" class="form-control" type="date" />
                                <span asp-validation-for="Employee.HireDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Employee.Email" class="form-label fw-semibold"></label>
                                <input asp-for="Employee.Email" class="form-control" />
                                <span asp-validation-for="Employee.Email" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Employee.PhoneNumber" class="form-label fw-semibold"></label>
                                <input asp-for="Employee.PhoneNumber" class="form-control" />
                                <span asp-validation-for="Employee.PhoneNumber" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Employee.DepartmentId" class="form-label fw-semibold"></label>
                                <select asp-for="Employee.DepartmentId" asp-items="Model.DepartmentList" class="form-select">
                                    <option value="">-- Select Department --</option>
                                </select>
                                <span asp-validation-for="Employee.DepartmentId" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Employee.Shift" class="form-label fw-semibold"></label>
                                <input asp-for="Employee.Shift" class="form-control" type="number" />
                                <span asp-validation-for="Employee.Shift" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mt-4 d-flex gap-2">
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-check-circle"></i> Save Changes
                            </button>
                            <a asp-page="Details" asp-route-id="@Model.Employee.Id" class="btn btn-outline-info">
                                <i class="bi bi-info-circle"></i> Details
                            </a>
                            <a asp-page="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
