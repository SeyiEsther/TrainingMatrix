@page
@model TrainingMatrixApp.Pages.TrainingCourses.IndexModel
@{
    ViewData["Title"] = "Training Courses";
}

<partial name="_Alerts" />

<div class="page-header">
    @await Html.PartialAsync("_PageHeader", new PageHeaderModel {
        Title = "Training courses",
        Subtitle = "Catalogue of courses linked to employee training records",
        Icon = "bi-journal-bookmark-fill"
    })
    <div class="page-header__actions">
        <a asp-page="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add course</a>
    </div>
</div>

<div class="filter-bar">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label">Search</label>
            <input type="text" name="searchString" value="@Model.SearchString"
                   class="form-control" placeholder="Name, code, or provider..." />
        </div>
        <div class="col-md-4">
            <label class="form-label">Category</label>
            <select name="categoryFilter" class="form-select">
                <option value="">All categories</option>
                @foreach (var cat in Model.CategoryList)
                {
                    <option value="@cat.Value" selected="@(cat.Value == Model.CategoryFilter)">@cat.Text</option>
                }
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button class="btn btn-primary flex-grow-1" type="submit"><i class="bi bi-search"></i> Apply</button>
            <a asp-page="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i></a>
        </div>
    </form>
</div>

<div class="tm-panel">
    <div class="tm-panel__body">
        @if (Model.Courses.Any())
        {
            <div class="table-responsive">
                <table class="table tm-table mb-0">
                    <thead>
                        <tr>
                            <th>Course</th>
                            <th>Code</th>
                            <th>Provider</th>
                            <th>Duration</th>
                            <th>Category</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var course in Model.Courses)
                        {
                            <tr>
                                <td><a asp-page="Details" asp-route-id="@course.Id" class="fw-semibold text-decoration-none">@course.Name</a></td>
                                <td><code>@course.CourseCode</code></td>
                                <td class="text-muted">@course.Provider</td>
                                <td>@(course.DurationHours?.ToString() ?? "—") hrs</td>
                                <td>@if (course.Category != null) { <span class="badge bg-light text-dark border">@course.Category</span> }</td>
                                <td class="text-end">
                                    <div class="tm-actions">
                                        <a asp-page="Details" asp-route-id="@course.Id" class="tm-action-btn" data-bs-toggle="tooltip" title="Details"><i class="bi bi-eye"></i></a>
                                        <a asp-page="Edit" asp-route-id="@course.Id" class="tm-action-btn tm-action-btn--warn" data-bs-toggle="tooltip" title="Edit"><i class="bi bi-pencil"></i></a>
                                        <a asp-page="Delete" asp-route-id="@course.Id" class="tm-action-btn tm-action-btn--danger" data-bs-toggle="tooltip" title="Delete"><i class="bi bi-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            @await Html.PartialAsync("_EmptyState", new EmptyStateModel { Icon = "bi-journal-bookmark", Message = "No training courses found.", ActionText = "Add course", ActionUrl = Url.Page("Create") })
        }
    </div>
</div>
