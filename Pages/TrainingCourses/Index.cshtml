@page
@model TrainingMatrixApp.Pages.TrainingCourses.IndexModel
@{
    ViewData["Title"] = "Training Courses";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show anim" role="alert">
        <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show anim" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="page-header anim">
    <div>
        <h1 class="page-title">Training Courses</h1>
        <p class="page-subtitle">Manage courses, providers, and learning paths.</p>
    </div>
    <a asp-page="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle-fill"></i> Add Course
    </a>
</div>

<form method="get">
    <div class="search-bar anim">
        <div class="search-field flex-grow-1" style="max-width:320px;">
            <i class="bi bi-search"></i>
            <input type="text" name="searchString" value="@Model.SearchString"
                   class="form-control" placeholder="Search by name, code, or provider…">
        </div>
        <div style="min-width:180px;">
            <select name="categoryFilter" class="form-select">
                <option value="">All Categories</option>
                @foreach (var cat in Model.CategoryList)
                {
                    <option value="@cat.Value" selected="@(cat.Value == Model.CategoryFilter)">@cat.Text</option>
                }
            </select>
        </div>
        <button class="btn btn-primary" type="submit"><i class="bi bi-search"></i> Search</button>
        <a asp-page="Index" class="btn btn-outline-secondary"><i class="bi bi-x"></i> Clear</a>
    </div>
</form>

<div class="card anim">
    <div class="card-body p-0">
        @if (Model.Courses.Any())
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Course</th>
                            <th>Code</th>
                            <th>Provider</th>
                            <th>Duration</th>
                            <th>Category</th>
                            <th style="width:100px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var course in Model.Courses)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div style="width:30px;height:30px;background:#e0f2fe;border-radius:8px;display:flex;align-items:center;justify-content:center;color:var(--info);font-size:0.85rem;flex-shrink:0;">
                                            <i class="bi bi-journal-bookmark-fill"></i>
                                        </div>
                                        <span class="fw-600">@course.Name</span>
                                    </div>
                                </td>
                                <td><code style="background:#f1f5f9;padding:2px 7px;border-radius:5px;font-size:0.78rem;color:var(--primary);">@course.CourseCode</code></td>
                                <td class="text-sm">@course.Provider</td>
                                <td class="text-sm text-color-muted">
                                    <i class="bi bi-clock me-1"></i>@course.DurationHours hrs
                                </td>
                                <td>
                                    @if (course.Category != null)
                                    {
                                        <span class="badge bg-info">@course.Category</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-page="Details" asp-route-id="@course.Id" class="btn btn-sm btn-info btn-icon" title="Details"><i class="bi bi-info-circle"></i></a>
                                        <a asp-page="Edit" asp-route-id="@course.Id" class="btn btn-sm btn-warning btn-icon" title="Edit"><i class="bi bi-pencil"></i></a>
                                        <a asp-page="Delete" asp-route-id="@course.Id" class="btn btn-sm btn-danger btn-icon" title="Delete"><i class="bi bi-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <span class="empty-state-icon"><i class="bi bi-journal-bookmark"></i></span>
                <h6>No courses found</h6>
                <p><a asp-page="Create">Add the first training course</a></p>
            </div>
        }
    </div>
</div>
