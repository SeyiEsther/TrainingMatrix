@page
@model TrainingMatrixApp.Pages.TrainingCourses.CreateModel
@{
    ViewData["Title"] = "Create Training Course";
}

<div class="container">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-4"><i class="bi bi-plus-circle"></i> Create Training Course</h1>
        </div>
        <div class="col-auto">
            <a asp-page="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-9">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Course Details</h5>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row g-3">
                            <div class="col-md-8">
                                <label asp-for="Course.Name" class="form-label fw-semibold"></label>
                                <input asp-for="Course.Name" class="form-control" placeholder="Course name" />
                                <span asp-validation-for="Course.Name" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Course.CourseCode" class="form-label fw-semibold"></label>
                                <input asp-for="Course.CourseCode" class="form-control" placeholder="e.g. TC-001" />
                                <span asp-validation-for="Course.CourseCode" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Course.Provider" class="form-label fw-semibold"></label>
                                <input asp-for="Course.Provider" class="form-control" placeholder="Training provider" />
                                <span asp-validation-for="Course.Provider" class="text-danger"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Course.DurationHours" class="form-label fw-semibold"></label>
                                <input asp-for="Course.DurationHours" class="form-control" type="number" />
                                <span asp-validation-for="Course.DurationHours" class="text-danger"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Course.ValidityMonths" class="form-label fw-semibold"></label>
                                <input asp-for="Course.ValidityMonths" class="form-control" type="number" />
                                <span asp-validation-for="Course.ValidityMonths" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Course.Category" class="form-label fw-semibold"></label>
                                <input asp-for="Course.Category" class="form-control" placeholder="e.g. Safety, Technical" />
                                <span asp-validation-for="Course.Category" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Course.PassingScore" class="form-label fw-semibold"></label>
                                <input asp-for="Course.PassingScore" class="form-control" type="number" step="0.1" />
                                <span asp-validation-for="Course.PassingScore" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Course.Cost" class="form-label fw-semibold"></label>
                                <input asp-for="Course.Cost" class="form-control" type="number" step="0.01" />
                                <span asp-validation-for="Course.Cost" class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Course.Description" class="form-label fw-semibold"></label>
                                <textarea asp-for="Course.Description" class="form-control" rows="3" placeholder="Optional description"></textarea>
                                <span asp-validation-for="Course.Description" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mt-4 d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> Create Course
                            </button>
                            <a asp-page="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
