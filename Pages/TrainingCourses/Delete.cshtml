@page
@model TrainingMatrixApp.Pages.TrainingCourses.DeleteModel
@{
    ViewData["Title"] = "Delete Training Course";
}

<div class="container">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-4 text-danger"><i class="bi bi-trash"></i> Delete Training Course</h1>
        </div>
    </div>

    <div class="alert alert-warning" role="alert">
        <h4 class="alert-heading">Warning!</h4>
        <p>Are you sure you want to deactivate this training course? This will mark it as inactive.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">Course Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Name:</dt>
                        <dd class="col-sm-8">@Model.Course.Name</dd>

                        <dt class="col-sm-4">Code:</dt>
                        <dd class="col-sm-8"><code>@(Model.Course.CourseCode ?? "N/A")</code></dd>

                        <dt class="col-sm-4">Provider:</dt>
                        <dd class="col-sm-8">@(Model.Course.Provider ?? "N/A")</dd>

                        <dt class="col-sm-4">Enrolled Employees:</dt>
                        <dd class="col-sm-8">@Model.EnrolledCount</dd>
                    </dl>

                    <form method="post">
                        <input type="hidden" asp-for="Course.Id" />
                        <div class="mt-3 d-flex gap-2">
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash"></i> Confirm Deactivate
                            </button>
                            <a asp-page="Index" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                            <a asp-page="Details" asp-route-id="@Model.Course.Id" class="btn btn-outline-info">
                                <i class="bi bi-info-circle"></i> View Details
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
