@page
@model TrainingMatrixApp.Pages.TrainingTasks.IndexModel
@{
    ViewData["Title"] = "Training Tasks";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-4"><i class="bi bi-list-check"></i> Training Tasks</h1>
            <p class="text-muted">Department training tasks and required skills</p>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <form method="get" class="input-group">
                <input type="text" name="searchString" value="@Model.SearchString" class="form-control" placeholder="Search tasks..." />
                <button class="btn btn-outline-primary" type="submit">
                    <i class="bi bi-search"></i> Search
                </button>
            </form>
        </div>
    </div>

    @if (Model.TrainingTasks.Any())
    {
        <div class="card shadow">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Task</th>
                                <th>Department</th>
                                <th>Skills</th>
                                <th>Target Count</th>
                                <th>Sort Order</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var task in Model.TrainingTasks)
                            {
                                <tr>
                                    <td>
                                        <strong>@task.Name</strong>
                                        @if (!string.IsNullOrWhiteSpace(task.Description))
                                        {
                                            <div class="text-muted small">@task.Description</div>
                                        }
                                    </td>
                                    <td>@task.Department?.Name</td>
                                    <td>
                                        @if (task.TrainingTaskSkills.Any())
                                        {
                                            @foreach (var skill in task.TrainingTaskSkills)
                                            {
                                                <span class="badge bg-info me-1">@skill.Skill?.Name</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">None assigned</span>
                                        }
                                    </td>
                                    <td>@(task.TargetEmployeeCount?.ToString() ?? "—")</td>
                                    <td>@(task.SortOrder?.ToString() ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i>
            No training tasks found.
            @if (!string.IsNullOrWhiteSpace(Model.SearchString))
            {
                <span> Try clearing your search.</span>
            }
        </div>
    }
</div>
