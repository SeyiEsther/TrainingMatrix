@page
@model TrainingMatrixApp.Pages.TrainingTasks.IndexModel
@{
    ViewData["Title"] = "Training Tasks";
}

<div class="page-header">
    @await Html.PartialAsync("_PageHeader", new PageHeaderModel {
        Title = "Training tasks",
        Subtitle = "Structured tasks linked to departments and required skills",
        Icon = "bi-list-check"
    })
</div>

<div class="filter-bar">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-9">
            <label class="form-label">Search</label>
            <input type="text" name="searchString" value="@Model.SearchString" class="form-control" placeholder="Search tasks..." />
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button class="btn btn-primary flex-grow-1" type="submit"><i class="bi bi-search"></i> Apply</button>
            <a asp-page="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i></a>
        </div>
    </form>
</div>

<div class="tm-panel">
    <div class="tm-panel__body">
        @if (Model.TrainingTasks.Any())
        {
            <div class="table-responsive">
                <table class="table tm-table mb-0">
                    <thead>
                        <tr>
                            <th>Task</th>
                            <th>Department</th>
                            <th>Skills</th>
                            <th>Target count</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var task in Model.TrainingTasks)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@task.Name</div>
                                    @if (!string.IsNullOrWhiteSpace(task.Description))
                                    {
                                        <small class="text-muted">@task.Description</small>
                                    }
                                </td>
                                <td>@task.Department?.Name</td>
                                <td>
                                    @if (task.TrainingTaskSkills.Any())
                                    {
                                        @foreach (var skill in task.TrainingTaskSkills)
                                        {
                                            <span class="badge bg-light text-dark border me-1">@skill.Skill?.Name</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>@(task.TargetEmployeeCount?.ToString() ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            @await Html.PartialAsync("_EmptyState", new EmptyStateModel { Icon = "bi-list-check", Message = "No training tasks found." })
        }
    </div>
</div>
