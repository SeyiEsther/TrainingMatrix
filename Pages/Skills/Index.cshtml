@page
@model TrainingMatrixApp.Pages.Skills.IndexModel
@{
    ViewData["Title"] = "Skills";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show anim" role="alert">
        <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show anim" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="page-header anim">
    <div>
        <h1 class="page-title">Skills</h1>
        <p class="page-subtitle">Define and categorise skills across your organisation.</p>
    </div>
    <a asp-page="Create" class="btn btn-primary">
        <i class="bi bi-patch-plus-fill"></i> Add Skill
    </a>
</div>

<!-- Search -->
<form method="get">
    <div class="search-bar anim">
        <div class="search-field flex-grow-1" style="max-width:300px;">
            <i class="bi bi-search"></i>
            <input type="text" name="searchString" value="@Model.SearchString"
                   class="form-control" placeholder="Search skills…">
        </div>
        <div style="min-width:180px;">
            <select name="categoryFilter" class="form-select">
                <option value="">All Categories</option>
                @foreach (var cat in Model.CategoryList)
                {
                    <option value="@cat.Value" selected="@(cat.Value == Model.CategoryFilter)">@cat.Text</option>
                }
            </select>
        </div>
        <button class="btn btn-primary" type="submit"><i class="bi bi-search"></i> Search</button>
        <a asp-page="Index" class="btn btn-outline-secondary"><i class="bi bi-x"></i> Clear</a>
    </div>
</form>

<div class="card anim">
    <div class="card-body p-0">
        @if (Model.Skills.Any())
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Skill Name</th>
                            <th>Category</th>
                            <th>Description</th>
                            <th style="width:90px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var skill in Model.Skills)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div style="width:30px;height:30px;background:var(--primary-light);border-radius:8px;display:flex;align-items:center;justify-content:center;color:var(--primary);font-size:0.85rem;flex-shrink:0;">
                                            <i class="bi bi-stars"></i>
                                        </div>
                                        <span class="fw-600">@skill.Name</span>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(skill.Category))
                                    {
                                        <span class="category-chip"><i class="bi bi-tag"></i> @skill.Category</span>
                                    }
                                </td>
                                <td class="text-sm text-color-muted">
                                    @(skill.Description?.Length > 90 ? skill.Description[..90] + "…" : skill.Description)
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-page="Edit" asp-route-id="@skill.Id" class="btn btn-sm btn-warning btn-icon" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-page="Delete" asp-route-id="@skill.Id" class="btn btn-sm btn-danger btn-icon" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <span class="empty-state-icon"><i class="bi bi-stars"></i></span>
                <h6>No skills found</h6>
                <p><a asp-page="Create">Add the first skill</a></p>
            </div>
        }
    </div>
</div>
