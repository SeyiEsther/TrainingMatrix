@page
@model TrainingMatrixApp.Pages.Skills.CreateModel
@{
    ViewData["Title"] = "Create Skill";
}

<div class="container">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-4"><i class="bi bi-plus-circle"></i> Create Skill</h1>
        </div>
        <div class="col-auto">
            <a asp-page="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Skill Details</h5>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Skill.Name" class="form-label fw-semibold"></label>
                            <input asp-for="Skill.Name" class="form-control" placeholder="e.g. Python Programming" />
                            <span asp-validation-for="Skill.Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Skill.Category" class="form-label fw-semibold"></label>
                            <input asp-for="Skill.Category" class="form-control" placeholder="e.g. Technical, Safety, Leadership" />
                            <span asp-validation-for="Skill.Category" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Skill.Description" class="form-label fw-semibold"></label>
                            <textarea asp-for="Skill.Description" class="form-control" rows="3" placeholder="Optional description"></textarea>
                            <span asp-validation-for="Skill.Description" class="text-danger"></span>
                        </div>

                        <div class="mt-4 d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> Create Skill
                            </button>
                            <a asp-page="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
